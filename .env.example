# ---- Orbes backend configuration ----
# Copy this file to ".env" and fill in real values. ".env" is git-ignored.

# App
ORBES_ENV=development
ORBES_SECRET_KEY=change-me-to-a-long-random-string
ORBES_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin account (seeded automatically on first startup)
ORBES_ADMIN_EMAIL=admin@example.com
ORBES_ADMIN_PASSWORD=change-me

# Database (SQLite by default; switch to postgresql://… for Postgres)
ORBES_DATABASE_URL=sqlite:///./orbes.db

# LLM provider (Anthropic Claude)
ANTHROPIC_API_KEY=
ORBES_LLM_MODEL=claude-opus-4-8
ORBES_LLM_MAX_TOKENS=2048

# Optional tool integrations
OPENWEATHER_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
